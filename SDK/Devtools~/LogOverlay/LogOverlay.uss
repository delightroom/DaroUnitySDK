/* LogOverlay — draggable floating debug log panel. Lives in its own
   UIDocument with PanelSettings.sortingOrder = 100 so it renders above
   both the main drill-down (sortingOrder 0) and NativeAdTestCanvas
   (sortingOrder 10). */

/* Root pass-through wrapper. picking-mode="Ignore" on the UXML element is
   what makes pointer events fall through; this rule just stretches the
   wrapper to the full screen and declares the brand palette as USS custom
   properties scoped to descendants (UI Toolkit USS supports class-level
   custom properties; :root pseudo-class isn't a guaranteed selector). */
.log-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    --daro-primary:        rgb(99, 0, 218);
    --daro-primary-hover:  rgb(151, 71, 255);
    --daro-text:           rgb(240, 235, 248);
    --daro-text-muted:     rgba(240, 235, 248, 0.65);
    --daro-surface:        rgba(28, 22, 38, 0.92);
}

/* --- Expanded panel ---------------------------------------------------- */

.log-panel {
    position: absolute;
    /* Default placement = bottom-right. Controller may overwrite left/top
       after a drag and persist via PlayerPrefs; in that case it also clears
       right/bottom to use top/left positioning explicitly. */
    right: 8px;
    bottom: 8px;
    /* Responsive — fill most of the screen on narrow phone aspects (portrait
       simulators land around 260-540 logical units wide on the panel after
       reference-resolution scaling), capped on wider game views so the
       overlay doesn't dominate the layout on desktop / tablet aspects. */
    width: 92%;
    max-width: 420px;
    min-width: 100px;
    height: 40%;
    max-height: 320px;
    min-height: 60px;
    padding: 0;
    background-color: var(--daro-surface);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(151, 71, 255, 0.25);
}

.log-handle {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    background-color: rgba(151, 71, 255, 0.10);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    /* Visual hint that this row is the drag handle. UI Toolkit has no
       cursor type system; the label below conveys it textually. */
}

.log-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--daro-text-muted);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.log-handle-buttons {
    flex-direction: row;
    align-items: center;
}

.log-handle-button {
    height: 18px;
    min-height: 18px;
    margin: 0 0 0 6px;
    padding: 0 8px;
    border-radius: 4px;
    border-width: 0;
    background-color: transparent;
    color: var(--daro-text-muted);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.log-handle-button:hover {
    background-color: rgba(151, 71, 255, 0.20);
    color: var(--daro-text);
}

/* Filter trigger — more prominent than the muted Clear / — buttons so the
   affordance reads as "open the filter UI". Outline-style chip with brand
   purple border + slightly bigger font for legibility on phone DPI. */
.log-handle-button--filter {
    padding: 0 8px;
    border-width: 1px;
    border-color: rgba(151, 71, 255, 0.55);
    border-radius: 9px;
    color: rgba(240, 235, 248, 0.95);
    font-size: 11px;
    -unity-font-style: bold;
}

.log-handle-button--filter:hover {
    background-color: rgba(151, 71, 255, 0.30);
}

/* Filter popup — opens from the ▾ button in the header. Anchored just
   below the drag handle on the right edge so it doesn't cover the title
   while sitting close to its trigger. Hidden by default. */
.log-filter-popup {
    position: absolute;
    top: 28px;
    right: 6px;
    width: 200px;
    background-color: rgb(28, 22, 38);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(151, 71, 255, 0.45);
    padding: 8px 10px;
    display: none;
}

.log-filter-group-label {
    font-size: 8px;
    -unity-font-style: bold;
    color: rgba(240, 235, 248, 0.55);
    margin: 0 0 2px 0;
    padding: 0;
}

.log-filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 0 6px 0;
}

.log-filter-toggle {
    margin: 0 6px 1px 0;
}

/* Toggle label — UI Toolkit names this `.unity-toggle__label` (not
   `__text`); the default theme paints it near-black which is invisible
   on the popup's dark surface, so we override colour + tighten size. */
.log-filter-toggle .unity-toggle__label {
    font-size: 10px;
    color: rgb(240, 235, 248);
    -unity-font-style: normal;
    min-width: 0;
    margin: 0 0 0 4px;
    padding: 0;
}

/* Toggle checkmark box — compact 12×12 with brand-purple accent so it
   reads as the "include this category" affordance, not a generic check. */
.log-filter-toggle .unity-toggle__input {
    margin: 0;
    padding: 0;
}

.log-filter-toggle .unity-toggle__checkmark {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    margin: 0;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(151, 71, 255, 0.55);
    background-color: transparent;
}

.log-filter-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(151, 71, 255, 0.85);
    border-color: rgba(151, 71, 255, 0.85);
}

/* Scroll view containing log-line labels. */
.log-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 4px 6px 6px 8px;
}

.log-scroll .unity-scroll-view__content-container {
    flex-direction: column;
}

/* Thin overlay scrollbar in brand purple — matches Main.uss event-log
   styling so the visual language stays consistent. */
.log-scroll .unity-scroll-view__vertical-scroller,
.log-scroll .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    background-color: transparent;
    border-width: 0;
}

.log-scroll .unity-scroller__low-button,
.log-scroll .unity-scroller__high-button {
    display: none;
}

.log-scroll .unity-scroller__slider,
.log-scroll .unity-base-slider--vertical {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin: 0;
    background-color: transparent;
    border-width: 0;
}

.log-scroll .unity-base-slider__tracker {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    left: 0;
    right: auto;
    margin: 0;
    background-color: rgba(151, 71, 255, 0.06);
    border-width: 0;
    border-radius: 3px;
}

.log-scroll .unity-base-slider__dragger {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    left: 0;
    margin: 0;
    background-color: rgba(151, 71, 255, 0.35);
    border-width: 0;
    border-radius: 3px;
}

.log-scroll .unity-base-slider__dragger:hover {
    background-color: rgba(151, 71, 255, 0.55);
}

/* --- Log rows ---------------------------------------------------------- */

/* Each row = [time] [badge] [main text] [meta]. flex-row so the cells line
   up across rows like a table. Whole row is clickable → opens detail modal. */
.log-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 1px 2px;
    margin: 0;
    flex-shrink: 0;
    border-radius: 2px;
}

.log-row:hover {
    background-color: rgba(151, 71, 255, 0.10);
}

/* Severity colours override source — a warn/error reads at-a-glance no
   matter who emitted it. */
.log-row--success .log-row-text { color: rgb(120, 255, 180); }
.log-row--warn    .log-row-text { color: rgb(255, 199, 120); }
.log-row--error   .log-row-text { color: rgb(255, 120, 120); }

.log-row-time {
    font-size: 9px;
    color: var(--daro-text-muted);
    margin: 0 3px 0 0;
    padding: 0;
    -unity-text-align: middle-left;
    /* Just enough for "HH:mm:ss" at 9px; tighter than the 50px default
       so badge / message get more room. */
    width: 38px;
    min-width: 38px;
    flex-shrink: 0;
}

.log-row-badge {
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(240, 235, 248);
    margin: 0 3px 0 0;
    padding: 0 3px;
    border-radius: 2px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* Sample-side ad events — primary brand purple so they stand out as the
   user-driven flow (Load → Loaded → Show → Shown → ...). */
.log-row-badge--ad {
    background-color: rgba(151, 71, 255, 0.85);
}

/* SDK trace of the SAME public event firing internally — same brand hue,
   intermediate alpha so it visually links to the SampleAdEvent row above
   without competing for attention. */
.log-row-badge--sdk-pub {
    background-color: rgba(151, 71, 255, 0.55);
    color: rgba(240, 235, 248, 0.95);
}

/* Pure SDK plumbing (ctor / Load / Show / Dispose / JNI / dispatcher) —
   most muted so it reads as supporting debug context, not consumer-facing
   signal. */
.log-row-badge--sdk {
    background-color: rgba(99, 0, 218, 0.30);
    color: rgba(240, 235, 248, 0.75);
}

/* Sample lifecycle / misc — neutral grey so it's distinguishable from
   ad events without competing for attention. */
.log-row-badge--misc {
    background-color: rgba(120, 120, 140, 0.45);
    color: rgba(240, 235, 248, 0.85);
}

.log-row-text {
    font-size: 10px;
    color: var(--daro-text);
    flex-grow: 1;
    flex-shrink: 1;
    /* nowrap + ellipsis — one row per line. Full detail (adUnitId / thread
       / latency / etc) lives in the detail modal so the scroll stays
       scannable. */
    white-space: nowrap;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.log-row-meta {
    font-size: 9px;
    color: var(--daro-text-muted);
    margin: 0 0 0 6px;
    padding: 0;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

/* --- Resize handles (4 corners) ---------------------------------------- */

.resize-handle {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: transparent;
}

.resize-handle--tl { left: -2px;  top: -2px; }
.resize-handle--tr { right: -2px; top: -2px; }
.resize-handle--bl { left: -2px;  bottom: -2px; }

/* BR gets a subtle visible grip (industry-standard signal that the window
   is resizable from the bottom-right corner). Other three remain
   invisible hit areas. */
.resize-handle--br {
    right: 0;
    bottom: 0;
    border-right-color: rgba(151, 71, 255, 0.45);
    border-bottom-color: rgba(151, 71, 255, 0.45);
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-bottom-right-radius: 9px;
}

.resize-handle:hover {
    background-color: rgba(151, 71, 255, 0.15);
}

/* --- Collapsed bubble -------------------------------------------------- */

.log-bubble {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: none; /* controller toggles to flex when panel is hidden */
}

.log-bubble-button {
    height: 28px;
    padding: 0 14px;
    border-radius: 14px;
    border-width: 0;
    background-color: var(--daro-primary);
    color: var(--daro-text);
    font-size: 11px;
    -unity-font-style: bold;
}

.log-bubble-button:hover {
    background-color: var(--daro-primary-hover);
}

/* --- Detail modal ------------------------------------------------------ */

/* Full-screen container — display: none until a row is clicked. Captures
   pointer events inside the sheet; backdrop click closes the modal. */
.log-detail-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
}

.log-detail-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.log-detail-sheet {
    width: 86%;
    max-width: 380px;
    height: 70%;
    max-height: 460px;
    min-width: 220px;
    min-height: 200px;
    background-color: var(--daro-surface);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(151, 71, 255, 0.35);
    padding: 0;
}

.log-detail-header {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 8px;
    background-color: rgba(151, 71, 255, 0.12);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.log-detail-badge {
    margin: 0 6px 0 0;
}

.log-detail-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--daro-text);
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.log-detail-close {
    width: 22px;
    min-width: 22px;
    height: 22px;
    min-height: 22px;
    padding: 0;
    margin: 0;
    border-radius: 11px;
    border-width: 0;
    background-color: transparent;
    color: var(--daro-text-muted);
    font-size: 11px;
    -unity-font-style: bold;
}

.log-detail-close:hover {
    background-color: rgba(151, 71, 255, 0.20);
    color: var(--daro-text);
}

.log-detail-scroll {
    flex-grow: 1;
    padding: 6px 10px 10px 10px;
}

.log-detail-fields {
    flex-direction: column;
    margin-bottom: 8px;
}

.log-detail-field {
    flex-direction: row;
    margin: 0;
    padding: 1px 0;
}

.log-detail-field-key {
    width: 80px;
    min-width: 80px;
    font-size: 10px;
    color: var(--daro-text-muted);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.log-detail-field-value {
    font-size: 10px;
    color: var(--daro-text);
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.log-detail-section-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--daro-text-muted);
    margin: 4px 0 2px 0;
    padding: 0;
}

.log-detail-raw {
    font-size: 9px;
    color: var(--daro-text);
    white-space: normal;
    background-color: rgba(0, 0, 0, 0.30);
    border-radius: 4px;
    padding: 6px 8px;
    margin: 0;
}
